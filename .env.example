# ═══════════════════════════════════════════════════════════════════════════
# PWOS environment configuration
#
# Copy to `.env` and adjust. Categories below mirror the production rules:
#   Required            — must be set for production
#   Authentication      — Supabase Auth, OAuth and bot protection
#   Optional            — feature toggles / external keys
#   Development only    — local dev / tests (NEVER in production)
#   Disabled by default — one-time operator flags (leave unset in production)
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Real PostgreSQL connection string. REQUIRED in production.
#
#   Local:   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwos
#   Hosted (Supabase pooler): DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=verify-full
#
# • Use sslmode=verify-full — it keeps the current secure behavior and
#   silences the pg v9 deprecation warning.
# • Use Supabase's transaction-pooler URL for Vercel runtime traffic.
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwos

# Direct Supabase connection used only by `npm run db:migrate`. Never expose it
# to browser code. Prefer the direct/session-pooler endpoint on an IPv6-capable
# operator machine; migrations must not use transaction pooling.
# MIGRATION_DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres?sslmode=verify-full

# Optional connection-pool tuning (defaults are environment-aware and safe):
#   production  → 10 connections per instance
#   development → 5  connections per instance
# Values are clamped to 1..50 so a typo can never exhaust the database.
# When you run behind PgBouncer / a pooled endpoint (e.g. Neon), keep this at
# the default or below the pooler's own size — extra local connections do not
# add throughput past the pooler.
# DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────

# Shared Redis store for application-level login/register throttling. Supabase
# Auth also applies its own limits; this second layer limits abusive requests
# before they reach Auth and works consistently across all Vercel instances.
# instances enforce ONE limit via atomic Redis counters. When unset (local
# development / memory:// tests) a per-process in-memory limiter is used.
# Development/test may fall back to an in-memory limiter. Production fails
# closed when Redis is missing or unavailable so limits cannot be bypassed.
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────

# Configure Google OAuth inside Supabase Dashboard > Authentication > Providers.
# Supabase Auth (Project Connect / API Keys). URL and publishable key are public.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Email that receives the initial owner role after signup. Server-only.
# PWOS_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# Canonical URL used for confirmation and password-reset callbacks. Required.
# NEXT_PUBLIC_SITE_URL=https://tavazon.vercel.app

# Cloudflare Turnstile site key. Put the Turnstile secret in Supabase Dashboard
# Authentication > Bot and Abuse Protection, not in Vercel.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
# 32 random bytes, base64 encoded. Required in production for sensitive PII.
# Generate once in a secure operator environment and store only in Vercel/KMS.
# FIELD_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# App mode:
#   personal     → never auto-load demo data (default; required for production)
#   development  → auto-seed demo data when the database is empty (local only)
# APP_MODE=personal

# Optional CoinGecko API key (server only). Never expose this through a
# NEXT_PUBLIC_* variable.
#
# Free Demo keys (default) must use api.coingecko.com:
#   COINGECKO_API_KEY=your-demo-key
#   COINGECKO_API_PLAN=demo
# Paid Pro keys:
#   COINGECKO_API_KEY=your-pro-key
#   COINGECKO_API_PLAN=pro
#
# On Vercel the unauthenticated public CoinGecko endpoint is often rate-limited.
# If CoinGecko fails, PWOS tries a public USDT spot ticker for supported coins
# (still a live market quote, never a fabricated price) and persists the last
# successful quote in `coingecko_price_cache` for Stale fallback.
# COINGECKO_API_KEY=your-coingecko-api-key
# COINGECKO_API_PLAN=demo

# ─────────────────────────────────────────────────────────────────────────────
# Development only (never set these in production)
# ─────────────────────────────────────────────────────────────────────────────

# Embedded in-memory database — zero network, zero setup (great for local dev).
# Data is kept in memory and is lost when the dev server restarts.
#   DATABASE_URL=memory://
#
# In production the app FAILS CLOSED if DATABASE_URL is unset or `memory://`:
# it refuses to run on the embedded database. Use a real PostgreSQL URL above.

# ─────────────────────────────────────────────────────────────────────────────
# Disabled by default — one-time operator flags (leave unset in production)
# ─────────────────────────────────────────────────────────────────────────────

# Force demo seeding regardless of APP_MODE. NEVER enable in production —
# demo financial data must not enter a real database. The runtime hard-blocks
# automatic demo seeding in production even if this is set.
# ALLOW_DEMO_SEED=true

# Legacy single-tenant → multi-tenant claim migration (opt-in, disabled by
# default). When a legacy owner account without a username exists, public
# registration will NEVER claim it unless this flag is explicitly enabled.
# Enable it ONLY on the operator console while performing the one-time
# migration (`PWOS_ALLOW_LEGACY_CLAIM=true npm run db:legacy-claim`), then
# remove it. Without this flag, registering creates a fresh low-privilege
# "user" account and leaves legacy data untouched.
# PWOS_ALLOW_LEGACY_CLAIM=true

# System admin API token (optional). Grants owner-level API access via the
# x-pwos-auth header / Authorization: Bearer. Server-side only — never prefix
# with NEXT_PUBLIC_. Keep unset unless needed.
# PWOS_AUTH_TOKEN=a-long-random-secret

# Emergency database restore. Keep unset in normal production; enable only
# during a supervised maintenance window and remove immediately afterwards.
# PWOS_ENABLE_RESTORE=true
