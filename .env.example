# ── Database ──────────────────────────────────────────────────────────────
# Real PostgreSQL (recommended for production / persistent data):
#   Local:  DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwos
#   Hosted (Neon/Supabase/…):
#     DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=verify-full
#     • Use sslmode=verify-full explicitly — it keeps the current secure
#       behavior and silences the pg v9 deprecation warning.
#     • Serverless databases (Neon free tier, …) sleep when idle; the first
#       request just needs a retry while the instance wakes up.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwos

# Embedded database — zero network, zero setup (great for local dev).
# Data is kept in memory and is lost when the dev server restarts.
# DATABASE_URL=memory://

# ── Authentication ────────────────────────────────────────────────────────
# Google Identity Services (the client id is public; use the same value for
# both variables so the browser button and server token verifier agree).
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── App mode ──────────────────────────────────────────────────────────────
# personal     → never auto-load demo data (default)
# development  → auto-seed demo data when the database is empty
# APP_MODE=development

# Force demo seeding regardless of APP_MODE:
# ALLOW_DEMO_SEED=true
